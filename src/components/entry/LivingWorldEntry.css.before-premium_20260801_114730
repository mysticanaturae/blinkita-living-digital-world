.living-world-entry {

    min-height: 100vh;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 60px 30px;

    background:

        radial-gradient(
            circle at center,
            rgba(255,255,255,0.12),
            transparent 55%
        );

}




.entry-inner {

    max-width: 1200px;

    width: 100%;

    text-align: center;

}





.entry-inner h1 {

    font-size: 4rem;

    margin-bottom: 20px;

    letter-spacing: 2px;

}





.entry-subtitle {

    font-size: 1.5rem;

    opacity: 0.85;

    margin-bottom: 30px;

}





.entry-message {

    font-size: 1.2rem;

    line-height: 1.8;

    margin-bottom: 60px;

}





.portal-preview {

    display: grid;

    grid-template-columns: repeat(
        auto-fit,
        minmax(220px,1fr)
    );

    gap: 25px;

    margin-bottom: 60px;

}





.portal-window {

    padding: 30px 25px;

    border-radius: 24px;

    background:

        rgba(255,255,255,0.08);


    backdrop-filter: blur(12px);


    border:

        1px solid rgba(255,255,255,0.15);


    transition:

        transform 0.4s ease,

        box-shadow 0.4s ease;

}





.portal-window:hover {

    transform:

        translateY(-8px);

}





.portal-window span {

    display:block;

    font-size:0.9rem;

    opacity:0.6;

    margin-bottom:10px;

}





.portal-window h3 {

    margin-bottom:12px;

}





.portal-window p {

    font-size:0.95rem;

    line-height:1.5;

    opacity:0.8;

}





.enter-world-button {


    padding:

        18px 45px;


    border-radius:

        999px;


    border:

        none;


    cursor:pointer;


    font-size:

        1.1rem;


    transition:

        transform .3s ease;


}





.enter-world-button:hover {


    transform:

        scale(1.05);


}