.living-world-entry {

    min-height: 100vh;

    width: 100%;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    background:
        radial-gradient(
            circle at center,
            rgba(255,255,255,0.08),
            transparent 45%
        ),
        linear-gradient(
            135deg,
            #0b0b18,
            #15152b,
            #050509
        );

    overflow: hidden;

    position: relative;

}



.living-world-entry::before {

    content: "";

    position: absolute;

    inset: 0;

    background:
        radial-gradient(
            circle,
            rgba(255,215,150,0.12),
            transparent 35%
        );

    animation: portalPulse 6s infinite ease-in-out;

}



.entry-inner {

    position: relative;

    z-index: 2;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    max-width: 900px;

    padding: 60px 40px;

}



.entry-inner h1 {

    font-size: clamp(3rem,6vw,5rem);

    font-weight: 500;

    letter-spacing: 0.08em;

    margin-bottom: 30px;

    color: #f8f3ea;

    animation: fadeIn 2s ease;

}



.entry-message {

    font-size: clamp(1.2rem,2vw,1.7rem);

    line-height: 1.8;

    max-width: 650px;

    color: rgba(255,255,255,0.85);

    letter-spacing: 0.04em;

    animation: fadeIn 3s ease;

}



.portal-opening {

    margin-top: 60px;

    width: 120px;

    height: 120px;

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    border: 1px solid rgba(255,255,255,0.35);

    box-shadow:

        0 0 40px rgba(255,220,150,0.25),

        inset 0 0 40px rgba(255,220,150,0.15);

    animation:

        portalGlow 5s infinite ease-in-out;

}



.portal-opening span {

    font-size: 60px;

    color: rgba(255,230,180,0.9);

}





@keyframes fadeIn {


    from {

        opacity: 0;

        transform: translateY(20px);

    }


    to {

        opacity: 1;

        transform: translateY(0);

    }

}



@keyframes portalGlow {


    0% {

        transform: scale(1);

        opacity: .6;

    }


    50% {

        transform: scale(1.15);

        opacity: 1;

    }


    100% {

        transform: scale(1);

        opacity: .6;

    }

}



@keyframes portalPulse {


    0% {

        opacity: .3;

    }


    50% {

        opacity: .8;

    }


    100% {

        opacity: .3;

    }

}
