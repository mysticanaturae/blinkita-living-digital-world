}

.my-living-tile-heading h3 {
    margin: 9px 0 9px;
    font-size: 25px;
    line-height: 1.15;
    font-weight: 600;
}

.my-living-tile-heading p {
    margin: 0;
    max-width: 430px;
    font-size: 13px;
    line-height: 1.7;
    opacity: .66;
}

.my-living-tile-content {
    flex: 1;
    margin-top: 24px;
    min-height: 0;
}

.my-living-analysis-inner .creator-analysis-card {
