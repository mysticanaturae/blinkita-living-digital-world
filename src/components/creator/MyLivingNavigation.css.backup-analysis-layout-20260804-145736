}

.my-living-analysis-inner .creator-analysis-progress {
    margin-top: 0;
}

.my-living-analysis-inner .creator-analysis-addition {
    display: none;
}

.my-living-analysis-inner .creator-analysis-footer {
    display: none;
}

.my-living-tile-footer {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-top: 20px;
    margin-top: 22px;
    border-top: 1px solid rgba(255,255,255,.08);
    font-size: 9px;
    letter-spacing: .16em;
    opacity: .48;
}

.my-living-deepen-visual {
    height: 92px;
    margin: 24px 0 20px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 8px;
    background:
        radial-gradient(circle, rgba(255,255,255,.09), transparent 62%),
        rgba(255,255,255,.035);
    border: 1px solid rgba(255,255,255,.07);
}

.my-living-deepen-visual span {
    font-size: 23px;
}

.my-living-deepen-visual small,
.my-living-world-visual small {
    font-size: 9px;
    letter-spacing: .18em;
    opacity: .5;
}

.my-living-deepen-space {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.my-living-deepen-space label,
.my-living-world-selector label {
    margin-bottom: 9px;
    font-size: 9px;
    letter-spacing: .17em;
    opacity: .5;
}

.my-living-deepen-input {
    flex: 1;
    width: 100%;
    min-height: 270px;
    resize: vertical;
    box-sizing: border-box;
    padding: 20px;
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,.1);
    background: rgba(0,0,0,.18);
    color: inherit;
    font: inherit;
    font-size: 13px;
    line-height: 1.75;
    outline: none;
}

.my-living-deepen-input:focus {
    border-color: rgba(255,255,255,.24);
    background: rgba(0,0,0,.23);
}

.my-living-deepen-button {
    width: 100%;
    margin-top: 18px;
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
}

.my-living-world-visual {
    flex: 1;
    min-height: 260px;
    margin: 24px 0;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 18px;
    background:
        radial-gradient(circle at center, rgba(255,255,255,.1), transparent 48%),
        rgba(255,255,255,.025);
    border: 1px solid rgba(255,255,255,.08);
}

.my-living-world-orbit {
    width: 108px;
    height: 108px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.15);
    box-shadow:
        0 0 0 14px rgba(255,255,255,.025),
        0 0 0 28px rgba(255,255,255,.015);
}

.my-living-world-orbit span {
    font-size: 30px;
}

.my-living-world-selector {
    display: flex;
    flex-direction: column;
}

.my-living-world-selector select {
    width: 100%;
    min-height: 48px;
}

.my-living-world-bottom {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgba(255,255,255,.08);
}

.my-living-world-bottom span {
    font-size: 16px;
}

.my-living-world-bottom small {
    font-size: 9px;
    letter-spacing: .15em;
    opacity: .45;
}

@media (max-width: 900px) {

    .my-living-analysis-mosaic {
        grid-template-columns: 1fr;
        gap: 18px;
    }

    .my-living-analysis-tile,
    .my-living-analysis-tile-primary,
    .my-living-analysis-tile-deepen,
    .my-living-analysis-tile-world {
        min-height: auto;
    }

    .my-living-analysis-tile {
        padding: 22px;
    }

    .my-living-analysis-inner {
        min-height: 420px;
    }

    .my-living-deepen-input {
        min-height: 300px;
    }

    .my-living-world-visual {
        min-height: 230px;
        flex: none;
    }
}

